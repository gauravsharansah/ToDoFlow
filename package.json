{
  "name": "todoflow",
  "version": "2.0.0",
  "author": {
    "name": "Gaurav Sharan Sah",
    "email": "shambhu1gaurabh@gmail.com"
  },
  "description": "ToDoFlow - Cross-Platform Todo App with Global Sync",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:publish": "electron-builder --publish always",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "android:build": "cap sync android && cd android && ./gradlew assembleRelease",
    "icons": "node generate-icons.js && node make-ico.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-updater": "^6.1.0",
    "firebase": "^12.13.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "sharp": "^0.33.0"
  },
  "build": {
    "appId": "com.todoflow.app",
    "productName": "ToDoFlow",
    "copyright": "Copyright © 2026 ToDoFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/icon.ico",
      "artifactName": "ToDoFlow-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ToDoFlow",
      "installerIcon": "src/icon.ico",
      "uninstallerIcon": "src/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "src/icon-512.png",
      "category": "public.app-category.productivity",
      "artifactName": "ToDoFlow-${version}-macOS.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "src/icon-512.png",
      "category": "Utility",
      "artifactName": "ToDoFlow-${version}-Linux.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "gauravsharansah",
      "repo": "todoflow",
      "private": false
    }
  }
}
